<configuration>
  <system.web>
    <customErrors mode="On" />
    <compilation debug="true" targetFramework="4.6.2"/>
    <httpRuntime targetFramework="4.6.2"/>
  </system.web>
  <system.webserver>
    <httpErrors errorMode="DetailedLocalOnly">
    </httpErrors>
  </system.webserver>
</configuration>
